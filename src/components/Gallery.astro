---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Image gallery.
 *
 * The first image shows large, the rest as thumbnails below it. Tapping a
 * thumbnail swaps it into the large slot. Fullscreen uses the native
 * <dialog>, so focus trapping and Escape work without a library.
 *
 * All images are converted to AVIF and WebP at build time, in several sizes.
 */
interface Item { src: ImageMetadata; alt: string; caption?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
if (!items.length) return null;
const single = items.length === 1;
---

<figure class="gallery" data-gallery>
  <div class="stage">
    {items.map((item, i) => (
      <div class="slide" data-index={i} hidden={i !== 0}>
        <Image
          src={item.src}
          alt={item.alt}
          widths={[640, 960, 1400]}
          sizes="(max-width: 800px) 100vw, 760px"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}

    <button type="button" class="expand" data-expand aria-label="نمایش در اندازهٔ کامل">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M9 4H4v5M15 4h5v5M15 20h5v-5M9 20H4v-5"></path>
      </svg>
    </button>
  </div>

  <figcaption data-caption>{items[0].caption ?? items[0].alt}</figcaption>

  {!single && (
    <ul class="thumbs" role="tablist" aria-label="تصاویر گالری">
      {items.map((item, i) => (
        <li role="presentation">
          <button
            type="button"
            role="tab"
            data-thumb={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`تصویر ${i + 1}: ${item.alt}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <Image src={item.src} alt="" widths={[160]} sizes="80px" loading="lazy" />
          </button>
        </li>
      ))}
    </ul>
  )}
</figure>

<dialog class="lightbox" data-lightbox aria-label="نمایش تصویر در اندازهٔ کامل">
  <button type="button" class="close" data-close aria-label="بستن">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="m6 6 12 12M18 6 6 18"></path>
    </svg>
  </button>
  <img data-lightbox-img alt="" />
</dialog>

<style>
  .gallery { margin: 2rem 0; }
  .stage {
    position: relative;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border-soft);
  }
  .slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70dvh;
    object-fit: contain;
    background: var(--surface);
  }
  .slide[hidden] { display: none; }

  .expand {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-end: 0.6rem;
    display: grid;
    place-items: center;
    width: 44px;
    min-height: 44px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(6px);
    color: var(--text);
  }
  .expand:hover { border-color: var(--accent); color: var(--accent); }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    text-align: center;
  }

  .thumbs {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0 0 0.3rem;
    overflow-x: auto;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
  }
  .thumbs button {
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: none;
    line-height: 0;
    min-height: 0;
    scroll-snap-align: start;
    opacity: 0.55;
    transition: opacity 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .thumbs :global(img) { width: 84px; height: 60px; object-fit: cover; display: block; }
  .thumbs button:hover { opacity: 1; }
  .thumbs button[aria-selected='true'] { opacity: 1; border-color: var(--accent); }

  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.92); }
  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .close {
    position: fixed;
    top: 1rem;
    inset-inline-end: 1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    min-height: 46px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(0 0 0 / 0.5);
    color: #fff;
  }
</style>

<script>
  document.querySelectorAll('[data-gallery]').forEach((root) => {
    const slides = [...root.querySelectorAll('.slide')] as HTMLElement[];
    const thumbs = [...root.querySelectorAll('[data-thumb]')] as HTMLButtonElement[];
    const caption = root.querySelector('[data-caption]') as HTMLElement | null;
    const captions = slides.map((_, i) => thumbs[i]?.getAttribute('aria-label') ?? '');
    const dialog = root.nextElementSibling as HTMLDialogElement | null;
    const bigImg = dialog?.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
    let active = 0;

    function show(i: number) {
      if (i === active || !slides[i]) return;
      slides[active].hidden = true;
      slides[i].hidden = false;
      thumbs[active]?.setAttribute('aria-selected', 'false');
      thumbs[i]?.setAttribute('aria-selected', 'true');
      if (thumbs[active]) thumbs[active].tabIndex = -1;
      if (thumbs[i]) thumbs[i].tabIndex = 0;
      if (caption) caption.textContent = captions[i]?.replace(/^تصویر \d+: /, '') ?? '';
      active = i;
    }

    thumbs.forEach((btn, i) => {
      btn.addEventListener('click', () => show(i));
      btn.addEventListener('keydown', (e) => {
        // Arrow keys are mirrored in RTL.
        let next = -1;
        if (e.key === 'ArrowLeft') next = (i + 1) % thumbs.length;
        if (e.key === 'ArrowRight') next = (i - 1 + thumbs.length) % thumbs.length;
        if (next < 0) return;
        e.preventDefault();
        show(next);
        thumbs[next].focus();
      });
    });

    root.querySelector('[data-expand]')?.addEventListener('click', () => {
      const img = slides[active].querySelector('img');
      if (!dialog || !bigImg || !img) return;
      bigImg.src = img.currentSrc || img.src;
      bigImg.alt = img.alt;
      dialog.showModal();
    });

    dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === bigImg) dialog.close();
    });
  });
</script>
