---
/**
 * Community links.
 *
 * Sits next to the website and repo buttons on an entity page. Each kind
 * carries its own icon and default label, so a page can list a Telegram
 * channel and a Telegram group side by side without them looking identical.
 */
interface Link {
  kind: string;
  url: string;
  label?: string;
  note?: string;
}
interface Props {
  links: Link[];
}
const { links } = Astro.props;
if (!links.length) return null;

/** Default label per kind. `label` on the link overrides it. */
const LABELS: Record<string, string> = {
  'telegram-channel': 'کانال تلگرام',
  'telegram-group': 'گروه تلگرام',
  mastodon: 'ماستودون',
  matrix: 'ماتریکس',
  discord: 'دیسکورد',
  slack: 'اسلک',
  zulip: 'زولیپ',
  irc: 'IRC',
  forum: 'انجمن',
  'mailing-list': 'فهرست پستی',
  stackoverflow: 'استک‌اورفلو',
  youtube: 'یوتیوب',
  peertube: 'پیرتیوب',
  x: 'ایکس',
  linkedin: 'لینکدین',
  bluesky: 'بلواسکای',
  wiki: 'ویکی',
  blog: 'وبلاگ',
  calendar: 'تقویم',
  other: 'پیوند',
};

/** Single-path icons, so each one costs almost nothing. */
