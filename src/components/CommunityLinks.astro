/** Which icon each kind draws. */
const ICON_FOR: Record<string, string> = {
  'telegram-channel': 'telegram',
  'telegram-group': 'telegram',
  mastodon: 'mastodon',
  matrix: 'matrix',
  discord: 'discord',
  slack: 'slack',
  zulip: 'chat',
  irc: 'chat',
  forum: 'chat',
  'mailing-list': 'mail',
  stackoverflow: 'stackoverflow',
  youtube: 'video',
  peertube: 'video',
  x: 'x',
  linkedin: 'linkedin',
  bluesky: 'bluesky',
  wiki: 'wiki',
  blog: 'wiki',
  calendar: 'calendar',
  other: 'link',
};

/** Icons that are outlines rather than solid shapes. */
const STROKED = new Set(['chat', 'link']);
---

<ul class="links">
  {links.map((link) => {
    const icon = ICON_FOR[link.kind] ?? 'link';
    const stroked = STROKED.has(icon);
    return (
      <li>
        <a href={link.url} rel="noopener" data-kind={link.kind} title={link.note}>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill={stroked ? 'none' : 'currentColor'}
            stroke={stroked ? 'currentColor' : undefined}
            stroke-width={stroked ? 2 : undefined}
            stroke-linecap={stroked ? 'round' : undefined}
            stroke-linejoin={stroked ? 'round' : undefined}
            aria-hidden="true"
          >
            <path d={ICONS[icon]}></path>
          </svg>
          <span>{link.label ?? LABELS[link.kind] ?? 'پیوند'}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.16s var(--ease), color 0.16s var(--ease), transform 0.16s var(--ease);
  }
  a:hover,
  a:focus-visible {
    color: var(--text);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  svg { flex: none; }

  /* Brand tints on hover only, so the row stays calm at rest. */
  [data-kind^='telegram']:hover { border-color: #2AABEE; color: #2AABEE; }
  [data-kind='mastodon']:hover { border-color: #6364FF; color: #6364FF; }
  [data-kind='matrix']:hover { border-color: #0DBD8B; color: #0DBD8B; }
  [data-kind='discord']:hover { border-color: #5865F2; color: #5865F2; }
  [data-kind='slack']:hover { border-color: #4A154B; color: var(--text); }
  [data-kind='zulip']:hover { border-color: #6492FE; color: #6492FE; }
  [data-kind='stackoverflow']:hover { border-color: #F48024; color: #F48024; }
  [data-kind='youtube']:hover { border-color: #FF0000; color: #FF0000; }
  [data-kind='linkedin']:hover { border-color: #0A66C2; color: #0A66C2; }
  [data-kind='bluesky']:hover { border-color: #0285FF; color: #0285FF; }

  @media (prefers-reduced-motion: reduce) {
    a:hover, a:focus-visible { transform: none; }
  }
</style>
