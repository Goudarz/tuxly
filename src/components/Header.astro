---
import Mark from './Mark.astro';
import { SITE } from '../consts';

const path = Astro.url.pathname;
const nav = [
  { href: '/news', label: 'اخبار' },
  { href: '/distributions', label: 'توزیع‌ها' },
  { href: '/desktops', label: 'میزکارها' },
  { href: '/projects', label: 'پروژه‌ها' },
  { href: '/events', label: 'رویدادها' },
  { href: '/communities', label: 'اجتماع‌ها' },
  { href: '/glossary', label: 'واژه‌نامه' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header data-pagefind-ignore>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name} — صفحهٔ خانه`}>
      <Mark size={30} />
      <span class="name">{SITE.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="ناوبری اصلی">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <button
        type="button"
        class="search-trigger"
        data-search-open
        aria-label="جست‌وجو در سایت"
        aria-haspopup="dialog"
      >
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <span class="label">جست‌وجو</span>
        <kbd class="latin">Ctrl K</kbd>
      </button>

      <button type="button" class="icon-btn" data-theme-toggle aria-label="تغییر تم روشن و تیره">
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        type="button"
        class="icon-btn menu-btn"
        data-menu-toggle
        aria-label="باز کردن منو"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path class="i-bars" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="i-close" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="ناوبری موبایل" hidden>
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
      <li class="sep"><a href="/brand">هویت بصری</a></li>
      <li><a href={`mailto:${SITE.email}`}><bdi class="latin">{SITE.email}</bdi></a></li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-soft);
  }
  @supports not (backdrop-filter: blur(1px)) {
    header { background: var(--bg); }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2.5vw, 2rem);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text);
    flex: none;
  }
  .name { font-weight: 800; font-size: var(--step-1); letter-spacing: -0.01em; }

  .desktop-nav ul {
    display: flex;
    gap: clamp(0.5rem, 1.6vw, 1.3rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a {
    display: block;
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    padding: 0.55rem 0.15rem;
    border-bottom: 2px solid transparent;
  }
  .desktop-nav a:hover { color: var(--text); }
  .desktop-nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }

  .tools { margin-inline-start: auto; display: flex; align-items: center; gap: 0.4rem; flex: none; }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 0.35rem 0.7rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .search-trigger:hover { border-color: var(--accent); color: var(--text); }
  .search-trigger kbd {
    font-size: 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    background: var(--bg);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    color: var(--text-muted);
  }
  .icon-btn:hover { color: var(--text); border-color: var(--border); }

  .i-sun { display: none; }
  :root[data-theme='light'] .i-moon { display: none; }
  :root[data-theme='light'] .i-sun { display: block; }
  .i-close { display: none; }
  header[data-menu-open] .i-bars { display: none; }
  header[data-menu-open] .i-close { display: block; }

  .menu-btn { display: none; }

  .mobile-nav {
    border-top: 1px solid var(--border-soft);
    background: var(--bg-elevated);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0.4rem var(--gutter) 1.2rem; }
  .mobile-nav a {
    display: block;
    padding: 0.8rem 0.2rem;
    text-decoration: none;
    font-size: var(--step-0);
    font-weight: 500;
    border-bottom: 1px solid var(--border-soft);
  }
  .mobile-nav a[aria-current='page'] { color: var(--accent); }
  .mobile-nav .sep { margin-top: 0.8rem; }

  @media (max-width: 1080px) {
    .desktop-nav { display: none; }
    .menu-btn { display: inline-grid; }
  }
  @media (max-width: 620px) {
    .search-trigger .label,
    .search-trigger kbd { display: none; }
    .search-trigger { width: 44px; justify-content: center; padding-inline: 0; min-height: 44px; }
    .name { font-size: var(--step-0); }
  }
</style>

<script>
  const header = document.querySelector('header');
  const menuBtn = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const mobileNav = document.getElementById('mobile-nav');

  function setMenu(open: boolean) {
    if (!header || !menuBtn || !mobileNav) return;
    header.toggleAttribute('data-menu-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'بستن منو' : 'باز کردن منو');
    mobileNav.toggleAttribute('hidden', !open);
  }

  menuBtn?.addEventListener('click', () => setMenu(!header?.hasAttribute('data-menu-open')));

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-menu-open')) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  matchMedia('(min-width: 1081px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem('tuxly-theme', next);
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'light' ? '#FAFAF7' : '#0F141C');
  });
</script>
