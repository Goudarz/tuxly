---
import type { CollectionEntry } from 'astro:content';
import { entityUrl, entityLabel } from '../lib/entities';

interface Props { entity: CollectionEntry<'entities'> }
const { entity } = Astro.props;
---

<a class="chip" href={entityUrl(entity)} data-type={entity.data.type}>
  <span class="dot" aria-hidden="true"></span>
  <bdi>{entityLabel(entity)}</bdi>
</a>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 0.25rem 0.7rem;
    color: var(--text-muted);
    min-height: 32px;
  }
  .chip:hover { border-color: var(--accent); color: var(--text); }
  .dot { width: 6px; height: 6px; border-radius: 2px; background: var(--text-muted); flex: none; }
  .chip[data-type='distribution'] .dot { background: var(--accent); }
  .chip[data-type='desktop'] .dot { background: var(--ok); border-radius: 50%; }
  .chip[data-type='windowmanager'] .dot { background: #7AA2F7; }
  .chip[data-type='project'] .dot { background: #C792EA; }
  .chip[data-type='community'] .dot { background: var(--warn); border-radius: 50%; }
</style>
