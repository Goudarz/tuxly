---
import Mark from './Mark.astro';
import { speakerUrl } from '../lib/speakers';
import { slugify } from '../lib/persian';

/**
 * Speakers on an event page.
 *
 * The initial stands in for a photo. Speaker photos would mean chasing
 * permission from every presenter for every event, which is not a cost
 * worth paying — a letter in the brand colour reads clearly and is never
 * wrong. Where a name has no usable initial, the Tuxly mark fills in.
 *
 * The name always links somewhere on this site — an author profile when
 * one is linked, otherwise the generated speaker page — so a reader can
 * see the rest of that person's talks. Any external link stays in the
 * card body rather than on the name.
 */
interface Speaker {
  name: string;
  talk?: string;
  role?: string;
  url?: string;
  author?: { id: string };
}
interface Props {
  speakers: Speaker[];
  title?: string;
}
const { speakers, title = 'ارائه‌دهندگان' } = Astro.props;
if (!speakers.length) return null;

/**
 * First letter of the name. Persian letters change shape when joined, so
 * an isolated letter here is the correct form — no ZWNJ tricks needed.
 */
function initial(name: string): string | null {
  const first = [...name.trim()][0];
  if (!first) return null;
  // Skip anything that is not a letter: quotes, digits, emoji.
  return /\p{L}/u.test(first) ? first : null;
}

/** Whether any speaker carries a talk title, which changes the layout. */
const detailed = speakers.some((s) => s.talk);
---

<section class="speakers" aria-labelledby="speakers-title">
  <h2 id="speakers-title">{title}</h2>

  <ul class:list={['list', { detailed }]}>
    {speakers.map((speaker) => {
      const letter = initial(speaker.name);
      const href = speakerUrl({ slug: slugify(speaker.name), authorId: speaker.author?.id });
      return (
        <li>
          <a class="card" href={href}>
            <span class="avatar" aria-hidden="true">
              {letter ? <bdi>{letter}</bdi> : <Mark size={22} />}
            </span>

            <span class="who">
              <span class="name"><bdi>{speaker.name}</bdi></span>
              {speaker.role && <span class="role"><bdi>{speaker.role}</bdi></span>}
              {speaker.talk && <span class="talk">{speaker.talk}</span>}
              <span class="more">همهٔ ارائه‌ها ←</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .speakers { margin-top: 2.5rem; }
  h2 { font-size: var(--step-1); margin: 0 0 1rem; }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  /* With talk titles the cards need the full column to stay readable. */
  .list.detailed { grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }

  .card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .card:hover, .card:focus-visible { border-color: var(--accent); transform: translateY(-2px); }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1;
  }

  .who { display: grid; gap: 0.1rem; min-width: 0; }
  .name { font-weight: 700; font-size: var(--step-0); }
  .role { font-size: var(--step--2); color: var(--text-muted); }
  .talk {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.7;
  }
  .card:hover .name { color: var(--accent); }

  /* The affordance appears on hover so the card stays quiet at rest. */
  .more {
    margin-top: 0.45rem;
    font-size: var(--step--2);
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.16s var(--ease);
  }
  .card:hover .more, .card:focus-visible .more { opacity: 1; }
  @media (hover: none) { .more { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .card:hover, .card:focus-visible { transform: none; }
    .more { transition: none; }
  }
</style>
