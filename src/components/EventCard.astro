---
import type { CollectionEntry } from 'astro:content';
import { faDateTime } from '../lib/persian';
import { slugOf } from '../lib/entities';

interface Props { event: CollectionEntry<'events'>; past?: boolean; compact?: boolean }
const { event, past = false, compact = false } = Astro.props;
const d = event.data;
const MODE = { 'in-person': 'حضوری', online: 'آنلاین', hybrid: 'حضوری و آنلاین' };
const place = d.mode === 'online' ? 'آنلاین' : [d.venue, d.city].filter(Boolean).join('، ');
---

<article class:list={['event', { past, compact, cancelled: d.cancelled }]}>
  <div class="when" aria-hidden="true">
    <span class="d">{new Intl.DateTimeFormat('fa-IR', { day: 'numeric' }).format(d.startsAt)}</span>
    <span class="m">{new Intl.DateTimeFormat('fa-IR', { month: 'long' }).format(d.startsAt)}</span>
  </div>

  <div class="body">
    <div class="meta">
      <span class="mode" data-mode={d.mode}>{MODE[d.mode]}</span>
      {d.cancelled && <span class="off">لغو شد</span>}
      <time datetime={d.startsAt.toISOString()}>{faDateTime(d.startsAt)}</time>
    </div>

    <h3><a href={`/events/${slugOf(event)}`}>{d.title}</a></h3>
    {!compact && <p class="summary">{d.summary}</p>}

    <ul class="facts">
      <li><span class="k">مکان</span> {place}</li>
      {!compact && d.price && <li><span class="k">هزینه</span> {d.price}</li>}
      {!compact && <li><span class="k">زبان</span> {d.language}</li>}
    </ul>
  </div>
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .event:last-child { border-bottom: 0; }
  .past { opacity: 0.62; }
  .cancelled h3 a { text-decoration: line-through; text-decoration-color: var(--warn); }

  .when {
    display: grid;
    place-content: center;
    text-align: center;
    width: 72px;
    height: 72px;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    background: var(--surface);
    flex: none;
  }
  .d { font-size: var(--step-2); font-weight: 800; line-height: 1; }
  .m { font-size: var(--step--2); color: var(--text-muted); }

  .meta { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; font-size: var(--step--1); color: var(--text-muted); }
  .mode { border-radius: 999px; padding: 0.1rem 0.65rem; font-size: var(--step--2); font-weight: 600; border: 1px solid var(--border); }
  .mode[data-mode='online'] { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); }
  .mode[data-mode='in-person'] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .off { color: var(--warn); font-weight: 600; }

  h3 { margin: 0.4rem 0 0.35rem; font-size: var(--step-1); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .summary { margin: 0; color: var(--text-muted); }

  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; margin: 0.8rem 0 0; padding: 0; font-size: var(--step--1); }
  .k { color: var(--text-muted); margin-inline-end: 0.35rem; }

  /* Compact: smaller date chip, clamped title, one fact line. */
  .compact { gap: 0.8rem; padding-block: 0.85rem; }
  .compact .when { width: 52px; height: 52px; }
  .compact .d { font-size: var(--step-0); }
  .compact .m { font-size: 0.62rem; }
  .compact h3 {
    font-size: var(--step--1);
    margin: 0.15rem 0 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .compact .meta { font-size: var(--step--2); gap: 0.4rem; }
  .compact .facts { margin-top: 0.35rem; font-size: var(--step--2); }
  .compact .mode { padding: 0.05rem 0.5rem; }

  @media (max-width: 520px) {
    .event:not(.compact) { grid-template-columns: 1fr; gap: 0.8rem; }
    .event:not(.compact) .when { width: auto; height: auto; padding: 0.5rem 0.9rem; display: flex; gap: 0.5rem; align-items: baseline; justify-self: start; }
    .event:not(.compact) .d { font-size: var(--step-1); }
  }
</style>
