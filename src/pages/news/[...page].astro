---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts } from '../../lib/entities';
import { collectionSchema } from '../../lib/schema';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const per = SITE.postsPerPage;
  const total = Math.max(1, Math.ceil(posts.length / per));
  return Array.from({ length: total }, (_, i) => {
    const page = i + 1;
    return {
      params: { page: page === 1 ? undefined : String(page) },
      props: { items: posts.slice(i * per, (i + 1) * per), page, total, count: posts.length },
    };
  });
}

const { items, page, total, count } = Astro.props;
const url = new URL('/news', SITE.url).href;
const schema = collectionSchema('اخبار و مطالب', url, 'همهٔ مطالب تاکسلی', count);
const title = page === 1 ? 'اخبار و مطالب' : `اخبار و مطالب — صفحهٔ ${page}`;
---

<BaseLayout
  title={title}
  description="اخبار روز، مقاله‌ها و آموزش‌های دنیای نرم‌افزار آزاد و متن‌باز، به فارسی."
  schema={schema}
  prev={page > 1 ? (page === 2 ? '/news' : `/news/${page - 1}`) : undefined}
  next={page < total ? `/news/${page + 1}` : undefined}
>
  <div class="wrap">
    <h1>اخبار و مطالب</h1>
    <PostList posts={items} page={page} totalPages={total} baseUrl="/news" total={count} />
  </div>
</BaseLayout>
