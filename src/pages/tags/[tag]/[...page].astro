---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getPublishedPosts, type Post } from '../../../lib/entities';
import { collectionSchema } from '../../../lib/schema';
import { SITE } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const per = SITE.postsPerPage;
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  const routes = [];
  for (const [tag, list] of byTag) {
    const total = Math.max(1, Math.ceil(list.length / per));
    for (let i = 0; i < total; i++) {
      routes.push({
        params: { tag, page: i === 0 ? undefined : String(i + 1) },
        props: { tag, items: list.slice(i * per, (i + 1) * per), page: i + 1, total, count: list.length },
      });
    }
  }
  return routes;
}

const { tag, items, page, total, count } = Astro.props;
const base = `/tags/${encodeURIComponent(tag)}`;
const url = new URL(base, SITE.url).href;
---

<BaseLayout
  title={page === 1 ? `برچسب: ${tag}` : `برچسب: ${tag} — صفحهٔ ${page}`}
  description={`مطالب مرتبط با ${tag} در تاکسلی.`}
  schema={collectionSchema(`برچسب ${tag}`, url, `مطالب مرتبط با ${tag}`, count)}
  feed={{ href: `${base}/rss.xml`, title: `${SITE.name} — ${tag}` }}
>
  <div class="wrap">
    <p class="kind">برچسب</p>
    <h1>{tag}</h1>
    <PostList posts={items} page={page} totalPages={total} baseUrl={base} total={count} />
  </div>
</BaseLayout>

<style>
  .kind { color: var(--accent); font-weight: 700; font-size: var(--step--1); margin: 0; }
  h1 { margin-top: 0.2rem; }
</style>
