---
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityChip from '../../components/EntityChip.astro';
import SearchIndex from '../../components/SearchIndex.astro';
import ShareBar from '../../components/ShareBar.astro';
import EventSpeakers from '../../components/EventSpeakers.astro';
import { speakerUrl } from '../../lib/speakers';
import { slugify } from '../../lib/persian';
import { faDateTimeWeekday, faTimeIn, tzLabel, offsetFromTehran, SITE_TZ } from '../../lib/persian';
import { eventSchema } from '../../lib/schema';
import { entityUrl, entityLabel, priceLabel } from '../../lib/entities';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return events.map((event) => ({ params: { slug: event.id.split('/').pop()! }, props: { event } }));
}

const { event } = Astro.props;
const d = event.data;
const { Content } = await render(event);
const organizer = d.organizer ? await getEntry(d.organizer) : undefined;
const related = d.entities.length ? await getEntries(d.entities) : [];

const url = new URL(Astro.url.pathname, SITE.url).href;
const schema = eventSchema(event, url, {
  organizerName: organizer ? entityLabel(organizer) : d.organizerName,
  organizerUrl: organizer
    ? new URL(entityUrl(organizer), SITE.url).href
    : undefined,
  imageUrl: d.cover ? new URL(d.cover.src, SITE.url).href : undefined,
});

const MODE = { 'in-person': 'حضوری', online: 'آنلاین', hybrid: 'حضوری و آنلاین' };

/*
 * Times display in Asia/Tehran. When the event is announced in another zone,
 * show that one too — the reader should not have to convert, and Iran's
 * half-hour offset makes mental arithmetic unusually easy to get wrong.
 */
const showsSourceZone =
  d.timezone !== SITE_TZ && offsetFromTehran(d.startsAt, d.timezone) !== 0;
const isPast = (d.endsAt ?? d.startsAt) < new Date();

const slug = event.id.split('/').pop()!;
const icsUrl = `/events/${slug}/event.ics`;

---

<BaseLayout title={d.title} description={d.summary} schema={schema} ogType="article">
  <div class="wrap" data-pagefind-body data-pagefind-meta="kind:رویداد">
    <header class="head">
      <p class="kind" data-pagefind-ignore>رویداد {MODE[d.mode]}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>

      {d.cancelled && <p class="alert">این رویداد لغو شده است.</p>}
      {!d.cancelled && isPast && <p class="alert past">این رویداد برگزار شده است.</p>}

      <dl class="facts">
        <div>
          <dt>شروع <span class="tz">به وقت تهران</span></dt>
          <dd>
            <time datetime={d.startsAt.toISOString()}>{faDateTimeWeekday(d.startsAt)}</time>
            {showsSourceZone && (
              <span class="alt-tz">
                {faTimeIn(d.startsAt, d.timezone)} <bdi>{tzLabel(d.startsAt, d.timezone)}</bdi>
              </span>
            )}
          </dd>
        </div>
        {d.endsAt && (
          <div>
            <dt>پایان <span class="tz">به وقت تهران</span></dt>
            <dd>
              <time datetime={d.endsAt.toISOString()}>{faDateTimeWeekday(d.endsAt)}</time>
              {showsSourceZone && (
                <span class="alt-tz">
                  {faTimeIn(d.endsAt, d.timezone)} <bdi>{tzLabel(d.endsAt, d.timezone)}</bdi>
                </span>
              )}
            </dd>
          </div>
        )}
        {d.mode !== 'online' && (
          <div><dt>مکان</dt><dd>{[d.venue, d.city, d.country].filter(Boolean).join('، ')}</dd></div>
        )}
        {organizer && (
          <div>
            <dt>برگزارکننده</dt>
            <dd><a href={entityUrl(organizer)}>{entityLabel(organizer)}</a></dd>
          </div>
        )}
        {!organizer && d.organizerName && <div><dt>برگزارکننده</dt><dd>{d.organizerName}</dd></div>}
        {d.performers.length > 0 && (
          <div>
            <dt>{d.performers.length > 1 ? 'ارائه‌دهندگان' : 'ارائه‌دهنده'}</dt>
            <dd class="people">
              {d.performers.map((p, i) => (
                <>
                  {i > 0 && '، '}
                  <a href={speakerUrl({ slug: slugify(p.name), authorId: p.author?.id })}>
                    <bdi>{p.name}</bdi>
                  </a>
                </>
              ))}
            </dd>
          </div>
        )}
        <div><dt>هزینه</dt><dd>{priceLabel(event)}</dd></div>
        <div><dt>زبان</dt><dd>{d.language}</dd></div>
      </dl>

      {d.address && <p class="addr muted">نشانی: {d.address}</p>}

      <div class="links" data-pagefind-ignore>
        {!d.cancelled && (
          <a class="btn btn-primary" href={icsUrl} download={`tuxly-${slug}.ics`} data-no-ext>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4.5" width="18" height="16" rx="2.5"></rect>
              <path d="M3 9.5h18M8 2.5v4M16 2.5v4M12 12v5m0 0-2-2m2 2 2-2"></path>
            </svg>
            افزودن به تقویم
          </a>
        )}
        {d.registerUrl && !isPast && !d.cancelled && (
          <a class="btn btn-primary" href={d.registerUrl} rel="noopener">نام‌نویسی</a>
        )}
        {d.onlineUrl && <a class="btn" href={d.onlineUrl} rel="noopener">پیوند اتصال</a>}
        {d.mapUrl && <a class="btn" href={d.mapUrl} rel="noopener">نقشه</a>}
      </div>

      {!d.cancelled && (
        <p class="cal-note muted">
          فایل <bdi class="latin">ICS</bdi> استاندارد باز تقویم است و در
          پروتون، نکست‌کلود، <bdi class="latin">Thunderbird</bdi> 
           و هر برنامهٔ دیگری باز می‌شود. یادآور یک‌ساعت‌قبل هم
          داخلش هست.
          {' '}
          <a href="/events#calendar">یا کل تقویم رویدادها را دنبال کنید</a>
        </p>
      )}
    </header>

    {d.cover && d.coverAlt && (
      <figure class="cover">
        <a href={d.cover.src} data-no-ext aria-label="نمایش پوستر در اندازهٔ کامل">
          <Image
            src={d.cover}
            alt={d.coverAlt}
            widths={[400, 700, 1000]}
            sizes="(max-width: 560px) 92vw, 460px"
            loading="lazy"
          />
        </a>
        <figcaption>پوستر رویداد — برای اندازهٔ کامل کلیک کنید یا ضربه بزنید</figcaption>
      </figure>
    )}

    <div class="prose"><Content /></div>

    <EventSpeakers speakers={d.performers} />

    <SearchIndex
      text={`${d.title} ${d.summary} ${d.topics.join(' ')} ${d.city ?? ''} ${d.performers
        .map((p) => `${p.name} ${p.talk ?? ''}`)
        .join(' ')}`}
    />

    {(related.length > 0 || d.topics.length > 0) && (
      <section class="prose">
        <h2>موضوع‌ها</h2>
        <div class="chips">
          {related.map((e) => <EntityChip entity={e} />)}
          {d.topics.map((t) => <span class="topic">{t}</span>)}
        </div>
      </section>
    )}

    <ShareBar title={d.title} />

    <p class="back"><a href="/events">بازگشت به تقویم رویدادها</a></p>
  </div>
</BaseLayout>

<style>
  .head { padding-block: 1rem 1.8rem; border-bottom: 1px solid var(--border-soft); }
  .kind { color: var(--accent); font-weight: 700; font-size: var(--step--1); margin: 0; }
  h1 { margin: 0.3rem 0 0.6rem; }
  .summary { max-width: var(--measure); color: var(--text-muted); margin: 0 0 1.3rem; }
  .alert {
    display: inline-block;
    border: 1px solid color-mix(in srgb, var(--warn) 45%, transparent);
    color: var(--warn);
    border-radius: var(--r-sm);
    padding: 0.5rem 0.9rem;
    font-size: var(--step--1);
    margin: 0 0 1.2rem;
  }
  .alert.past { border-color: var(--border); color: var(--text-muted); }
  .facts { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin: 0 0 1rem; }
  .facts > div { display: grid; gap: 0.1rem; }
  dt { color: var(--text-muted); font-size: var(--step--2); }
  dd { margin: 0; font-size: var(--step--1); font-weight: 600; }
  .people { max-width: 28ch; }
  .tz { font-weight: 400; opacity: 0.8; }
  .alt-tz {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--2);
    font-weight: 400;
    color: var(--text-muted);
  }
  .addr { font-size: var(--step--1); margin: 0 0 1.2rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .links .btn svg { flex: none; }
  .cal-note { font-size: var(--step--2); margin: 0.9rem 0 0; max-width: 62ch; }

  .cover {
    margin: 2.2rem auto 0;
    max-width: 460px;
    text-align: center;
  }
  .cover a {
    display: block;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .cover a:hover,
  .cover a:focus-visible { border-color: var(--accent); transform: translateY(-2px); }
  .cover :global(img) { width: 100%; height: auto; display: block; }
  .cover figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  @media (max-width: 560px) {
    .cover { max-width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover a:hover, .cover a:focus-visible { transform: none; }
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .topic {
    font-size: var(--step--1); color: var(--text-muted);
    border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.75rem;
  }
  .back { margin-top: 2.5rem; }
</style>
