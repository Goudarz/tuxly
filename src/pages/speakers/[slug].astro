---
import EventSpeakerProfile from '../../components/EventSpeakerProfile.astro';
import FigureProfile from '../../components/FigureProfile.astro';
import { getSpeakers } from '../../lib/speakers';
import { getFigures, getFigureRecord, figureSlug } from '../../lib/conferences';

/**
 * One directory for everyone who gives talks.
 *
 * Two sources feed it: speakers at events in Iran, generated from the
 * events (names only, no file to maintain), and figures from the
 * international conferences we cover, each with a written profile in
 * content/figures/. Different data, same idea, so they share a URL space
 * and a listing, and the reader never has to know which is which.
 */
export async function getStaticPaths() {
  const paths = [];

  for (const figure of await getFigures()) {
    const record = await getFigureRecord(figure.id);
    // A profile belongs to the site through a conference; one with no
    // appearance yet has nothing to show, so it waits.
    if (!record.length) continue;
    paths.push({ params: { slug: figureSlug(figure) }, props: { kind: 'figure' as const, figure, record } });
  }

  const taken = new Set(paths.map((p) => p.params.slug));
  for (const speaker of await getSpeakers()) {
    // Anyone linked to an author profile lives there instead.
    if (speaker.authorId) continue;
    if (taken.has(speaker.slug)) {
      throw new Error(
        `/speakers/${speaker.slug}: هم پروفایل چهره دارد و هم ارائه‌دهندهٔ رویداد است. یکی از دو نام را تغییر دهید.`,
      );
    }
    paths.push({ params: { slug: speaker.slug }, props: { kind: 'event' as const, speaker } });
  }

  return paths;
}

const props = Astro.props;
---

{props.kind === 'figure'
  ? <FigureProfile figure={props.figure} record={props.record} />
  : <EventSpeakerProfile speaker={props.speaker} />}
