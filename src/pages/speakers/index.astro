---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';
import { getSpeakers, speakerUrl } from '../../lib/speakers';
import { collectionSchema } from '../../lib/schema';
import { faNumber } from '../../lib/persian';
import { SITE } from '../../consts';

const url = new URL('/speakers', SITE.url).href;

/**
 * Prepared in frontmatter, not in the template.
 *
 * A regex literal inside a template expression trips Astro's parser — the
 * leading `/` reads as markup — so anything needing one is computed here.
 */
const speakers = (await getSpeakers()).map((speaker) => {
  const first = [...speaker.name.trim()][0];
  return {
    ...speaker,
    href: speakerUrl(speaker),
    // Persian letters are shaped when joined, so an isolated one is right.
    initial: first && /\p{L}/u.test(first) ? first : null,
  };
});
---

<BaseLayout
  title="ارائه‌دهندگان"
  description="کسانی که در رویدادهای ثبت‌شده در تاکسلی ارائه داده‌اند."
  schema={collectionSchema('ارائه‌دهندگان', url, 'ارائه‌دهندگان رویدادها', speakers.length)}
>
  <div class="wrap">
    <h1>ارائه‌دهندگان</h1>
    <p class="intro">
      کسانی که در رویدادهای ثبت‌شده در تاکسلی ارائه داده‌اند. این فهرست خودکار
      از روی رویدادها ساخته می‌شود.
    </p>

    {speakers.length === 0 ? (
      <p class="muted">هنوز ارائه‌ای ثبت نشده.</p>
    ) : (
      <ul class="grid">
        {speakers.map((speaker) => (
          <li>
            <a href={speaker.href}>
              <span class="avatar" aria-hidden="true">
                {speaker.initial ? <bdi>{speaker.initial}</bdi> : <Mark size={20} />}
              </span>
              <span class="who">
                <span class="name"><bdi>{speaker.name}</bdi></span>
                <span class="n tnum">{faNumber(speaker.talks.length)} ارائه</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .intro { max-width: var(--measure); color: var(--text-muted); }
  .grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.16s var(--ease);
  }
  a:hover, a:focus-visible { border-color: var(--accent); }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-weight: 700;
    line-height: 1;
  }
  .who { display: grid; gap: 0.1rem; min-width: 0; }
  .name { font-weight: 700; }
  a:hover .name { color: var(--accent); }
  .n { font-size: var(--step--2); color: var(--text-muted); }
</style>
