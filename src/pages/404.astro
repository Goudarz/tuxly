---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
---
<BaseLayout title="صفحه پیدا نشد" description="این نشانی در تاکسلی وجود ندارد." noindex>
  <div class="wrap box">
    <Mark size={86} />
    <h1>این نشانی وجود ندارد</h1>
    <p>ممکن است صفحه جابه‌جا شده باشد یا نشانی اشتباه تایپ شده باشد.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">بازگشت به خانه</a>
      <a class="btn" href="/news">فهرست مطالب</a>
      <a class="btn" href="/distributions">توزیع‌ها</a>
      <button type="button" class="btn" data-search-open>جست‌وجو</button>
    </div>
  </div>
</BaseLayout>

<style>
  .box { display: grid; justify-items: center; text-align: center; padding-block: 5rem; gap: 0.4rem; }
  .box :global(.mark) { color: var(--text-muted); }
  h1 { margin: 1rem 0 0; }
  p { color: var(--text-muted); margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-top: 1.6rem; }
</style>
