---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CopyToast from '../components/CopyToast.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  schema?: unknown;
  /** Per-page feed, in addition to the site-wide one. */
  feed?: { href: string; title: string };
  publishedAt?: Date;
  updatedAt?: Date;
  prev?: string;
  next?: string;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  ogImage = '/og/default.png',
  ogType = 'website',
  schema,
  feed,
  publishedAt,
  updatedAt,
  prev,
  next,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="fa-IR" dir="rtl" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {prev && <link rel="prev" href={new URL(prev, SITE.url).href} />}
    {next && <link rel="next" href={new URL(next, SITE.url).href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0F141C" />
    <meta name="color-scheme" content="dark light" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />

    <!--
      Both fonts are in the critical path: Vazirmatn for body text, Space
      Grotesk for the wordmark and Latin labels. Preloading them removes a
      round trip that would otherwise start only after the CSS parses.
    -->
    <link rel="preload" href="/fonts/Vazirmatn.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — همهٔ مطالب`} href="/rss.xml" />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" hreflang="fa" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fa_IR" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Dark is the default; only a saved "light" choice overrides it.
         Runs before first paint so there is no flash. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('tuxly-theme');
          if (saved === 'light') {
            document.documentElement.dataset.theme = 'light';
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#FAFAF7');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip">پرش به محتوای اصلی</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <SearchDialog />
    <CopyToast />

    <style>
      .skip {
        position: fixed;
        inset-inline-start: 1rem;
        top: -5rem;
        z-index: 100;
        background: var(--accent);
        color: var(--accent-ink);
        padding: 0.7rem 1.2rem;
        border-radius: var(--r-sm);
        font-weight: 700;
        text-decoration: none;
        transition: top 0.18s var(--ease);
      }
      .skip:focus-visible { top: 1rem; }
      main { min-height: 60vh; padding-block: clamp(1.2rem, 4vw, 2.5rem); }
      main:focus { outline: none; }
    </style>
  </body>
</html>
