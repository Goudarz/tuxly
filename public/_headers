# Cache headers for hosts that read this file (Cloudflare Pages, Netlify).
# Not used by GitHub Pages — set the equivalent rules in the CDN dashboard.

# Content-hashed filenames can never change, so cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts change only when we replace them, and then the URL changes too.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=2592000

/brand/*
  Cache-Control: public, max-age=2592000

# The search index is regenerated on every build.
/pagefind/*
  Cache-Control: public, max-age=86400

# HTML must revalidate so new posts appear immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
